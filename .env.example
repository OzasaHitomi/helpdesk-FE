# ===================================================
# .env.example — このファイルをコピーして .env を作成する
# $ cp .env.example .env
# ===================================================

# Backend API
# 通信先となるバックエンド（helpdesk-BE）のURLを指定する
# Viteの仕様上、VITE_ から始まる環境変数のみがブラウザ側に公開されるため、
# 新しく環境変数を追加する場合も必ず VITE_ プレフィックスを付与すること。
VITE_BACKEND_URL=http://localhost:8000
